# Copy to .env and adjust as needed:  cp .env.example .env
# No real secrets are required to run Tastable locally.

# PostgreSQL connection string. Locally: any Postgres 14+. Hosted: set automatically by the Vercel Neon integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tastable"

# Public base URL, used for share links and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs session cookies (real accounts and demo personas). Any long random string works locally;
# generate one with:  openssl rand -base64 32
# On Vercel, setting AUTH_SECRET is recommended; without it a key is derived from the database URL.
AUTH_SECRET="replace-me-with-a-long-random-string"

# Payments are always simulated. Set to "fail" to force simulated payment failures for testing.
SIMULATED_PAYMENTS_MODE="succeed"

# Optional: freeze the server clock (ISO 8601) for demos and tests. Leave unset for real time.
# The seed anchors its sample dates to this clock too, so re-seed after changing it.
# TASTABLE_FIXED_NOW="2026-11-02T17:00:00.000Z"

# Optional: use a preinstalled Chromium for Playwright instead of `npx playwright install`.
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chrome"
